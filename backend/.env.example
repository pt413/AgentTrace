# Copy this file to backend/.env. It is loaded only by the backend process.
# Do not commit backend/.env or paste its values into agent settings.

# Optional: populates the UI with example trace data at startup.
AGENTTRACE_DEMO=false

# Put provider credentials here. In AgentTrace, enter only the variable name
# (for example, OPENAI_API_KEY) in an LLM or external-agent token field.
OPENAI_API_KEY=

